# AI Web Builder — environment template. Copy to .env and fill in.
# Nothing here is secret; real values live in your host's secret manager.

# ---- Core ----
NODE_ENV=development
PORT=5050
# Session cookie signing secret. Generate: openssl rand -hex 32
SESSION_SECRET=

# ---- Database (Postgres) ----
# Unset => in-memory storage (dev only; data is lost on restart).
DATABASE_URL=
# Cloud Run + Cloud SQL only: colon-free socket dir (see storage.ts). Leave unset on Railway/local.
DB_SOCKET_PATH=

# ---- Publishing ----
# Comma-separated hosts that serve the APP (not published sites), e.g.:
#   ai-webbuilder.com,www.ai-webbuilder.com,localhost:5050
APP_HOSTS=
# Public origin used in Stripe redirect URLs.
APP_URL=http://localhost:5050
# Apex domain published sites live under: <slug>.PUBLISH_DOMAIN
PUBLISH_DOMAIN=ai-webbuilder.com

# ---- Billing (Stripe) ----
# See docs/STRIPE_SETUP.md for how to create these. Billing is DISABLED until
# STRIPE_SECRET_KEY and STRIPE_PRICE_PRO are both set.
STRIPE_SECRET_KEY=
STRIPE_PRICE_PRO=
STRIPE_WEBHOOK_SECRET=

# ---- Living site (self-optimizing growth agent) ----
# The scheduler is OFF unless this is exactly "1". Set to 1 in production to
# deliver the "living site" promise. Each site also needs a goal to be optimized.
GROWTH_AGENT_ENABLED=0
GROWTH_INTERVAL_MS=900000

# ---- Acquisition funnel / admin ----
# Shared secret guarding GET /api/admin/funnel. Unset => endpoint 404s.
ADMIN_KEY=
# Salt for hashing anonymous visitor IPs in the funnel. Any stable string.
FUNNEL_SALT=ai-webbuilder

# ---- Model routing ----
# Two clouds. A model id beginning "@cf/" is served by Cloudflare Workers AI;
# anything else is an Azure Foundry deployment. A fallback chain may mix both:
# each model is resolved separately, and one whose cloud has no credentials here
# is skipped rather than failing the request. Configure either, or both.

# Cloudflare Workers AI. Needed for every @cf/ model, which is where the
# defaults live. CLOUDFLARE_API_KEY is accepted as an alias for the token.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Azure AI Foundry. The safety net at the end of every chain.
AZURE_CORE_ENDPOINT=
AZURE_CORE_API_KEY=
AZURE_API_VERSION=
AZURE_IMAGE_API_VERSION=
AZURE_VIDEO_API_VERSION=

# Per-tier primary. Unset means the built-in default:
#   anonymous / free -> @cf/zai-org/glm-5.2
#   pro              -> @cf/moonshotai/kimi-k2.7-code
AI_WEBBUILDER_MODEL=
AI_WEBBUILDER_ANON_MODEL=
AI_WEBBUILDER_FREE_MODEL=
AI_WEBBUILDER_PRO_MODEL=
# Shared tail, tried after the tier primary.
# Default: @cf/zai-org/glm-5.2,model-router,DeepSeek-V4-Flash
AI_WEBBUILDER_FALLBACK_MODELS=

# Per-task override, ahead of the tier chain. Comma-separated.
# Tasks route by what the work is, not just who is asking: building or patching a
# document leads with the code model (it answers directly), while planning and
# chat lead with the reasoning model (its scratchpad is billed to max_tokens, so
# it is the wrong thing to put in front of a long document).
AI_WEBBUILDER_GENERATE_MODELS=
AI_WEBBUILDER_REFINE_MODELS=
AI_WEBBUILDER_PLAN_MODELS=
AI_WEBBUILDER_CHAT_MODELS=

# Answer budget. Raised from 4096 because a reasoning model spends part of it
# thinking, which truncated real pages mid-document.
AI_WEBBUILDER_MAX_TOKENS=

AI_WEBBUILDER_IMAGE_MODEL=
AI_WEBBUILDER_VIDEO_MODEL=

# ---- Stock photography (optional; falls back to gradient placeholders) ----
STOCK_IMAGE_API_KEY=
STOCK_IMAGE_PROVIDER=

# ---- Agent-native payments (x402; optional) ----
# Enabled when BOTH X402_PAY_TO_ADDRESS and X402_FACILITATOR_URL are set;
# otherwise agent builds answer 503 payments_unavailable.
AGENT_PRICE_BUILD_USDC=
AGENT_PRICE_REFINE_USDC=
# EVM address that receives USDC (0x...).
X402_PAY_TO_ADDRESS=
# Facilitator speaking the x402 v1 /verify + /settle REST contract,
# e.g. https://facilitator.payai.network (Base mainnet, no API key).
X402_FACILITATOR_URL=
# Chain id (default: base). Known networks get USDC contract + EIP-712 domain
# defaults automatically; other networks must set the three vars below.
X402_NETWORK=
# Payment token contract ADDRESS override (not a symbol).
X402_ASSET=
# Token EIP-712 domain overrides (must match the token contract's name()/version()).
X402_ASSET_NAME=
X402_ASSET_VERSION=
