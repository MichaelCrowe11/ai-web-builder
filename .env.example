# AI Web Builder — environment template. Copy to .env and fill in.
# Nothing here is secret; real values live in your host's secret manager.

# ---- Core ----
NODE_ENV=development
PORT=5050
# Session cookie signing secret. Generate: openssl rand -hex 32
SESSION_SECRET=

# ---- Database (Postgres) ----
# Unset => in-memory storage (dev only; data is lost on restart).
DATABASE_URL=
# Cloud Run + Cloud SQL only: colon-free socket dir (see storage.ts). Leave unset on Railway/local.
DB_SOCKET_PATH=

# ---- Publishing ----
# Comma-separated hosts that serve the APP (not published sites), e.g.:
#   ai-webbuilder.com,www.ai-webbuilder.com,localhost:5050
APP_HOSTS=
# Public origin used in Stripe redirect URLs.
APP_URL=http://localhost:5050
# Apex domain published sites live under: <slug>.PUBLISH_DOMAIN
PUBLISH_DOMAIN=ai-webbuilder.com

# ---- Billing (Stripe) ----
# See docs/STRIPE_SETUP.md for how to create these. Billing is DISABLED until
# STRIPE_SECRET_KEY and STRIPE_PRICE_PRO are both set.
STRIPE_SECRET_KEY=
STRIPE_PRICE_PRO=
STRIPE_WEBHOOK_SECRET=

# ---- Living site (self-optimizing growth agent) ----
# The scheduler is OFF unless this is exactly "1". Set to 1 in production to
# deliver the "living site" promise. Each site also needs a goal to be optimized.
GROWTH_AGENT_ENABLED=0
GROWTH_INTERVAL_MS=900000

# ---- Acquisition funnel / admin ----
# Shared secret guarding GET /api/admin/funnel. Unset => endpoint 404s.
ADMIN_KEY=
# Salt for hashing anonymous visitor IPs in the funnel. Any stable string.
FUNNEL_SALT=ai-webbuilder

# ---- Model routing (Azure / Crowe) ----
AZURE_CORE_ENDPOINT=
AZURE_CORE_API_KEY=
AZURE_API_VERSION=
AZURE_IMAGE_API_VERSION=
AZURE_VIDEO_API_VERSION=
AI_WEBBUILDER_MODEL=
AI_WEBBUILDER_ANON_MODEL=
AI_WEBBUILDER_FREE_MODEL=
AI_WEBBUILDER_PRO_MODEL=
AI_WEBBUILDER_FALLBACK_MODELS=
AI_WEBBUILDER_IMAGE_MODEL=
AI_WEBBUILDER_VIDEO_MODEL=

# ---- Stock photography (optional; falls back to gradient placeholders) ----
STOCK_IMAGE_API_KEY=
STOCK_IMAGE_PROVIDER=

# ---- Agent-native payments (x402; optional) ----
AGENT_PRICE_BUILD_USDC=
AGENT_PRICE_REFINE_USDC=
X402_ASSET=
X402_NETWORK=
X402_FACILITATOR_URL=
X402_PAY_TO_ADDRESS=
